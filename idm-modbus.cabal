cabal-version:      3.4
name:               idm-modbus
version:            0.1.0.0
synopsis:           Modbus TCP for iDM heat pumps with Navigator 10 control
description:
  A faithful transcription of the manufacturer's Modbus TCP parameter list,
  verified against a running machine, and a client that reads it.
  Please see the Readme at <https://github.com/dschrempf/idm-modbus#readme>

category:           Hardware, Network
homepage:           https://github.com/dschrempf/idm-modbus#readme
bug-reports:        https://github.com/dschrempf/idm-modbus/issues
author:             Dominik Schrempf
maintainer:         dominik.schrempf@gmail.com
copyright:          2026 Dominik Schrempf
license:            BSD-3-Clause
license-file:       License.txt
build-type:         Simple
extra-doc-files:
  Changelog.md
  doc/*.md
  doc/verification/*.md
  Readme.md

extra-source-files:
  data/navigator-10-enums.tsv
  data/navigator-10-registers.tsv
  data/navigator-10-software.tsv

source-repository head
  location: https://github.com/dschrempf/idm-modbus
  type:     git

common lib
  default-language: Haskell2010
  ghc-options:      -Wall -Wunused-packages -Wredundant-constraints

common test
  default-language: Haskell2010
  ghc-options:      -Wall -Wunused-packages -Wredundant-constraints

common exec
  default-language: Haskell2010
  ghc-options:
    -Wall -Wunused-packages -Wredundant-constraints -threaded -rtsopts
    -with-rtsopts=-N

-- What the test suite needs and a consumer must not reach: the core of a
-- write takes any register, not only a target, and the socket connects and
-- writes without a session.
library core
  import:          lib
  exposed-modules:
    IDM.Modbus.TCP
    IDM.Modbus.TCP.Internal
    IDM.Navigator.Register
    IDM.Navigator.Write.Core

  hs-source-dirs:  lib/core
  build-depends:
    , base              >=4.7 && <5
    , bytestring
    , network
    , template-haskell
    , text

-- What idm-web's watch decides about the Fachmann level, where the test
-- suite reaches it: a test suite cannot import a module of an executable.
library fachmann
  import:          lib
  exposed-modules: IDM.Navigator.Web.Fachmann
  hs-source-dirs:  lib/fachmann
  build-depends:
    , base        >=4.7 && <5
    , idm-modbus

library
  import:             lib
  reexported-modules:
    IDM.Modbus.TCP,
    IDM.Navigator.Register

  exposed-modules:
    IDM.Navigator.Capture
    IDM.Navigator.Client
    IDM.Navigator.Drive
    IDM.Navigator.Rounds
    IDM.Navigator.Software
    IDM.Navigator.Table
    IDM.Navigator.Target
    IDM.Navigator.Web
    IDM.Navigator.Web.Level
    IDM.Navigator.Web.Session
    IDM.Navigator.Write

  other-modules:
    IDM.Navigator.Table.Parse
    IDM.Navigator.Target.Splice
    IDM.Navigator.Web.Connection

  hs-source-dirs:     lib/idm-modbus
  build-depends:
    , aeson
    , base              >=4.7 && <5
    , bytestring
    , containers
    , idm-modbus:core
    , network
    , stm
    , template-haskell
    , text
    , time
    , websockets

-- The schedule @idm-drive@ runs: a measurement, fixed before a run, and no
-- interface, so a consumer does not reach it.
library schedule
  import:          lib
  exposed-modules:
    IDM.Navigator.Schedule
    IDM.Navigator.Schedule.Log
    IDM.Navigator.Schedule.Parse
    IDM.Navigator.Schedule.Step

  hs-source-dirs:  lib/schedule
  build-depends:
    , base         >=4.7 && <5
    , idm-modbus
    , text
    , time
    , toml-parser  >=2.0 && <2.1

executable idm-dump
  import:         exec
  main-is:        Main.hs
  hs-source-dirs: app/dump
  build-depends:
    , base        >=4.7 && <5
    , bytestring
    , idm-modbus
    , text

executable idm-drive
  import:         exec
  main-is:        Main.hs
  hs-source-dirs: app/drive
  build-depends:
    , base                 >=4.7 && <5
    , bytestring
    , idm-modbus
    , idm-modbus:schedule
    , text
    , time
    , unix

executable idm-web
  import:         exec
  main-is:        Main.hs
  hs-source-dirs: app/web
  build-depends:
    , aeson
    , base                 >=4.7 && <5
    , bytestring
    , idm-modbus
    , idm-modbus:fachmann
    , text
    , time
    , unix

executable idm-write
  import:         exec
  main-is:        Main.hs
  hs-source-dirs: app/write
  build-depends:
    , base        >=4.7 && <5
    , bytestring
    , idm-modbus
    , text

test-suite idm-modbus-test
  import:         test
  type:           exitcode-stdio-1.0
  main-is:        Main.hs
  hs-source-dirs: test
  build-depends:
    , aeson
    , base                 >=4.7 && <5
    , bytestring
    , containers
    , directory
    , filepath
    , idm-modbus
    , idm-modbus:core
    , idm-modbus:fachmann
    , idm-modbus:schedule
    , text
    , time
    , transformers
