cabal-version:      3.4
name:               idm-modbus
version:            0.1.0.0
synopsis:           Modbus TCP for iDM heat pumps with Navigator 2.0 control
description:
  A faithful transcription of the manufacturer's Modbus TCP parameter list,
  verified against a running machine, and a client that reads it.
  Please see the Readme at <https://github.com/dschrempf/idm-modbus#readme>

category:           Hardware, Network
homepage:           https://github.com/dschrempf/idm-modbus#readme
bug-reports:        https://github.com/dschrempf/idm-modbus/issues
author:             Dominik Schrempf
maintainer:         dominik.schrempf@gmail.com
copyright:          2026 Dominik Schrempf
license:            BSD-3-Clause
license-file:       License.txt
build-type:         Simple
extra-doc-files:
  Changelog.md
  doc/research.md
  doc/verification-2026-09-19.md
  doc/verification-2026-09-20-webapi.md
  doc/verification-2026-09-20.md
  doc/verification-2026-10-01-charge.md
  doc/verification-2026-10-14-gltmon.md
  Readme.md

extra-source-files:
  data/navigator-2.0-enums.tsv
  data/navigator-2.0-registers.tsv

source-repository head
  location: https://github.com/dschrempf/idm-modbus
  type:     git

common lib
  default-language: Haskell2010
  ghc-options:      -Wall -Wunused-packages -Wredundant-constraints

common test
  default-language: Haskell2010
  ghc-options:      -Wall -Wunused-packages -Wredundant-constraints

common exec
  default-language: Haskell2010
  ghc-options:
    -Wall -Wunused-packages -Wredundant-constraints -threaded -rtsopts
    -with-rtsopts=-N

-- What the test suite needs and a consumer must not reach: the core of a
-- write takes any register, not only a target.
library core
  import:          lib
  exposed-modules:
    IDM.Modbus.TCP
    IDM.Navigator.Register
    IDM.Navigator.Write.Core

  hs-source-dirs:  core
  build-depends:
    , base              >=4.7 && <5
    , bytestring
    , network
    , template-haskell
    , text

library
  import:             lib
  reexported-modules:
    IDM.Modbus.TCP,
    IDM.Navigator.Register

  exposed-modules:
    IDM.Navigator.Client
    IDM.Navigator.Table
    IDM.Navigator.Target
    IDM.Navigator.Web
    IDM.Navigator.Web.Level
    IDM.Navigator.Web.Session
    IDM.Navigator.Write

  other-modules:
    IDM.Navigator.Table.Parse
    IDM.Navigator.Target.Splice
    IDM.Navigator.Web.Connection

  hs-source-dirs:     src
  build-depends:
    , aeson
    , base              >=4.7 && <5
    , bytestring
    , containers
    , idm-modbus:core
    , network
    , stm
    , template-haskell
    , text
    , time
    , websockets

executable idm-dump
  import:         exec
  main-is:        Main.hs
  hs-source-dirs: app
  build-depends:
    , base        >=4.7 && <5
    , bytestring
    , containers
    , idm-modbus
    , text
    , time

executable idm-web
  import:         exec
  main-is:        Main.hs
  hs-source-dirs: app-web
  build-depends:
    , aeson
    , base        >=4.7 && <5
    , bytestring
    , idm-modbus
    , text
    , time

executable idm-write
  import:         exec
  main-is:        Main.hs
  hs-source-dirs: app-write
  build-depends:
    , base        >=4.7 && <5
    , bytestring
    , idm-modbus
    , text

test-suite idm-modbus-test
  import:         test
  type:           exitcode-stdio-1.0
  main-is:        Main.hs
  hs-source-dirs: test
  build-depends:
    , aeson
    , base             >=4.7 && <5
    , bytestring
    , containers
    , idm-modbus
    , idm-modbus:core
    , text
    , transformers
